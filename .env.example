# Sha Silvers — environment
#
# Copy to `.env` and fill in. All storefront variables are required: the app
# talks to the Shopify Storefront API only, with no offline catalogue to fall
# back on, so `npm run dev` needs a linked store to render products.
#
# Run `npx shopify hydrogen link` to fill these in automatically, or set them
# by hand from Settings → Apps → Headless in the Shopify admin.

# Signs the session cookie. Any long random string; change it per environment.
SESSION_SECRET="change-me"

# --- Storefront -------------------------------------------------------------
PUBLIC_STORE_DOMAIN="your-store.myshopify.com"
PUBLIC_STOREFRONT_API_TOKEN=""
PRIVATE_STOREFRONT_API_TOKEN=""
PUBLIC_STOREFRONT_ID=""
PUBLIC_CHECKOUT_DOMAIN="your-store.myshopify.com"

# --- Customer accounts (order tracking, saved addresses) --------------------
# Hydrogen 2026.4 builds the customer-account URLs from SHOP_ID itself; the
# older PUBLIC_CUSTOMER_ACCOUNT_API_URL is no longer read. SHOP_ID is the
# numeric id in the shop gid, e.g. gid://shopify/Shop/78705229964.
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=""
SHOP_ID=""

# --- Seeding (optional, never used by the storefront) -----------------------
# Only `npm run seed` reads this. Admin API token from Settings → Apps and
# sales channels → Develop apps → your app → Admin API access token. Needs
# read/write_products and read/write_publications. Leave blank in production —
# the running site never talks to the Admin API.
SHOPIFY_ADMIN_API_TOKEN=""
